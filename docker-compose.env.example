# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# New Relic (OTEL export — no .NET agent, grouped by service.namespace=AspireOllama)
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# Azure AD - Web Frontend (OIDC client)
AZUREAD_TENANT_ID=your_tenant_id
AZUREAD_WEB_CLIENT_ID=your_web_client_id
AZUREAD_WEB_CLIENT_SECRET=your_web_client_secret
AZUREAD_AUDIENCE=api://your_app_id

# Azure AD - Backend Services (JWT validation)
AZUREAD_BACKEND_CLIENT_ID=your_backend_client_id
AZUREAD_BACKEND_CLIENT_SECRET=your_backend_client_secret

# SerpAPI (web search) — free tier: 100 searches/month at serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# Gateway shared secret
GATEWAY_SHARED_SECRET=your_gateway_shared_secret

# Gateway ports (optional, defaults: 80/443)
# GATEWAY_HTTP_PORT=80
# GATEWAY_HTTPS_PORT=443

# ── TLS: Choose ONE of the options below ──

# Option A: Let's Encrypt (direct TLS termination at gateway)
# Set USE_CLOUDFLARE=false and provide domain/email.
LETSENCRYPT_DOMAIN=
LETSENCRYPT_EMAIL=

# Option B: Cloudflare Tunnel (TLS at Cloudflare edge)
# Set USE_CLOUDFLARE=true — Let's Encrypt is automatically disabled.
# Cloudflared sidecar always starts and connects to gateway over HTTP.
USE_CLOUDFLARE=true
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
