# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# New Relic
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key_here

# Azure AD - Web Frontend (OIDC client)
AZUREAD_TENANT_ID=your_tenant_id
AZUREAD_WEB_CLIENT_ID=your_web_client_id
AZUREAD_WEB_CLIENT_SECRET=your_web_client_secret
AZUREAD_AUDIENCE=api://your_app_id

# Azure AD - Backend Services (JWT validation)
AZUREAD_BACKEND_CLIENT_ID=your_backend_client_id
AZUREAD_BACKEND_CLIENT_SECRET=your_backend_client_secret

# Gateway shared secret
GATEWAY_SHARED_SECRET=your_gateway_shared_secret

# Let's Encrypt (leave empty to disable HTTPS)
LETSENCRYPT_DOMAIN=aspireollama.example.com
LETSENCRYPT_EMAIL=admin@example.com
