        cursor: pointer;
        font-size: 1rem;
    }

    .send-button:hover:not(:disabled) {
        background-color: #0056b3;
    }

    .send-button:disabled {
        background-color: #ccc;
        cursor: not-allowed;
    }

    .error-message {
        margin-top: 1rem;
        padding: 0.75rem;
        background-color: #f8d7da;
        color: #721c24;
        border-radius: 4px;
    }
</style>

@code {
    [Parameter]
    public string? SessionId { get; set; }

    private List<ChatSession> sessions = new();
    private List<ChatMessageDisplay> messages = new();
    private List<ImageAttachment> pendingImages = new();
    private string currentMessage = string.Empty;
    private string? currentSessionId;
    private bool isLoading = false;
    private string? errorMessage;

    private const int MaxImages = 5;
    private const long MaxImageSize = 10 * 1024 * 1024; // 10MB
    private static readonly HashSet<string> SupportedContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg",
        "image/jpg",
        "image/png",
        "image/gif",
        "image/webp"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();

        if (!string.IsNullOrEmpty(SessionId))
        {
            await LoadSession(SessionId);
        }
        else if (sessions.Count == 0)
        {
            await CreateNewSession();
        }
        else
        {
            await LoadSession(sessions[0].Id);
        }
    }

    private async Task LoadSessions()
    {
        try
        {
            sessions = await ChatClient.GetSessionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load sessions: {ex.Message}";
        }
    }

    private async Task CreateNewSession()
    {
        try
        {
            var session = await ChatClient.CreateSessionAsync();
            sessions.Insert(0, session);
            currentSessionId = session.Id;
            messages.Clear();
            pendingImages.Clear();
            Navigation.NavigateTo($"/chat/{session.Id}", replace: true);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create session: {ex.Message}";
        }
    }

    private async Task LoadSession(string sessionId)
    {
        try
        {
            var sessionDetails = await ChatClient.GetSessionHistoryAsync(sessionId);
            if (sessionDetails != null)
            {
                currentSessionId = sessionId;
                messages = sessionDetails.Messages.Select(m => new ChatMessageDisplay(
                    m.Content,
                    m.Role == "user",
                    m.Images
                )).ToList();
                pendingImages.Clear();
                Navigation.NavigateTo($"/chat/{sessionId}", replace: true);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load session: {ex.Message}";
        }
    }

    private async Task DeleteSession(string sessionId)
    {
        try
        {
            await ChatClient.DeleteSessionAsync(sessionId);
            sessions.RemoveAll(s => s.Id == sessionId);

            if (currentSessionId == sessionId)
            {
                if (sessions.Count > 0)
                {
                    await LoadSession(sessions[0].Id);
                }
                else
                {
                    await CreateNewSession();
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete session: {ex.Message}";
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;

        foreach (var file in e.GetMultipleFiles(MaxImages - pendingImages.Count))
        {
            if (pendingImages.Count >= MaxImages)
            {
                errorMessage = $"Maximum {MaxImages} images allowed.";
                break;
            }

            if (!SupportedContentTypes.Contains(file.ContentType))
            {
                errorMessage = $"Unsupported file type: {file.Name}. Only JPEG, PNG, GIF, and WebP are supported.";
                continue;
            }

            if (file.Size > MaxImageSize)
            {
                errorMessage = $"Image {file.Name} exceeds 10MB limit.";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(MaxImageSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());

                // Normalize content type
                var contentType = file.ContentType.ToLowerInvariant() switch
                {
                    "image/jpg" => "image/jpeg",
                    _ => file.ContentType.ToLowerInvariant()
                };

                pendingImages.Add(new ImageAttachment
                {
                    FileName = file.Name,
                    ContentType = contentType,
                    Base64Data = base64
                });
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to read image {file.Name}: {ex.Message}";
            }
        }

        StateHasChanged();
    }

    private void RemoveImage(ImageAttachment image)
    {
        pendingImages.Remove(image);
        StateHasChanged();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading && (!string.IsNullOrWhiteSpace(currentMessage) || pendingImages.Count > 0))
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if ((string.IsNullOrWhiteSpace(currentMessage) && pendingImages.Count == 0) || isLoading || string.IsNullOrEmpty(currentSessionId))
            return;

        var userMessage = currentMessage.Trim();
        var imagesToSend = pendingImages.ToList();
        currentMessage = string.Empty;
        pendingImages.Clear();
        errorMessage = null;

        messages.Add(new ChatMessageDisplay(userMessage, true, imagesToSend));
        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new ChatMessageRequest
            {
                SessionId = currentSessionId,
                Content = userMessage,
                Images = imagesToSend
            };

            var response = await ChatClient.SendMessageAsync(request);
            messages.Add(new ChatMessageDisplay(response.Response, false, new List<ImageAttachment>()));

            // Update session title in the list if this was the first message
            var session = sessions.FirstOrDefault(s => s.Id == currentSessionId);
            if (session != null && session.Title == "New Chat" && !string.IsNullOrEmpty(userMessage))
            {
                session.Title = userMessage.Length > 50 ? userMessage.Substring(0, 47) + "..." : userMessage;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private record ChatMessageDisplay(string Content, bool IsUser, List<ImageAttachment> Images);
}
