@page "/"
@page "/chat/{SessionId?}"
@using AspireOllama.Web
@using AspireOllama.Shared
@inject ChatApiClient ChatClient
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Chat</PageTitle>

<div class="chat-layout">
    <div class="sidebar">
        <div class="sidebar-header">
            <h3>Chat History</h3>
            <button class="new-chat-btn" @onclick="CreateNewSession">+ New Chat</button>
        </div>
        <div class="session-list">
            @foreach (var session in sessions)
            {
                <div class="session-item @(session.Id == currentSessionId ? "active" : "")" @onclick="() => LoadSession(session.Id)">
                    <span class="session-title">@session.Title</span>
                    <button class="delete-btn" @onclick:stopPropagation="true" @onclick="() => DeleteSession(session.Id)">x</button>
                </div>
            }
        </div>
    </div>

    <div class="chat-container">
        <div class="messages-container">
            @foreach (var message in messages)
            {
                <div class="message @(message.IsUser ? "user-message" : "assistant-message")">
                    <div class="message-header">
                        <strong>@(message.IsUser ? "You" : "Assistant")</strong>
                    </div>
                    @if (message.Images.Count > 0)
                    {
                        <div class="message-images">
                            @foreach (var image in message.Images)
                            {
                                <img src="data:@image.ContentType;base64,@image.Base64Data" alt="@image.FileName" class="message-image" />
                            }
                        </div>
                    }
                    @if (message.Files.Count > 0)
                    {
                        <div class="message-files">
                            @foreach (var file in message.Files)
                            {
                                <div class="file-badge">
                                    <span class="file-icon">@GetFileIcon(file.Type)</span>
                                    <span class="file-name">@file.FileName</span>
                                </div>
                            }
                        </div>
                    }
                    <div class="message-content">@message.Content</div>
                </div>
            }
            @if (isLoading)
            {
                <div class="message assistant-message">
                    <div class="message-header">
                        <strong>Assistant</strong>
                    </div>
                    <div class="message-content">
                        <em>Thinking...</em>
                    </div>
                </div>
            }
        </div>

        @if (pendingImages.Count > 0 || pendingFiles.Count > 0)
        {
            <div class="attachments-preview-container">
                @foreach (var image in pendingImages)
                {
                    <div class="image-preview">
                        <img src="data:@image.ContentType;base64,@image.Base64Data" alt="@image.FileName" />
                        <button class="remove-btn" @onclick="() => RemoveImage(image)">x</button>
                    </div>
                }
                @foreach (var file in pendingFiles)
                {
                    <div class="file-preview">
                        <span class="file-icon">@GetFileIcon(file.Type)</span>
                        <span class="file-name">@file.FileName</span>
                        <button class="remove-btn" @onclick="() => RemoveFile(file)">x</button>
                    </div>
                }
            </div>
        }

        <div class="input-container">
            <label class="upload-btn" title="Attach files (images, PDF, Word, Excel, PowerPoint, text)">
                <InputFile OnChange="HandleFileSelected" accept="@AcceptedFileTypes" multiple disabled="@isLoading" />
                <span>+</span>
            </label>
            <input type="text"
                   @bind="currentMessage"
                   @bind:event="oninput"
                   @onkeypress="HandleKeyPress"
                   placeholder="Type your message..."
                   disabled="@isLoading"
                   class="message-input" />
            <button @onclick="SendMessage" disabled="@(isLoading || (string.IsNullOrWhiteSpace(currentMessage) && pendingImages.Count == 0 && pendingFiles.Count == 0))" class="send-button">
                Send
            </button>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">
                @errorMessage
            </div>
        }
    </div>
</div>

<style>
