@page "/"
@page "/chat/{SessionId?}"
@using AspireOllama.Web
@using AspireOllama.Shared
@inject ChatApiClient ChatClient
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Chat</PageTitle>

<div class="chat-layout">
    <div class="sidebar">
        <div class="sidebar-header">
            <h3>Chat History</h3>
            <button class="new-chat-btn" @onclick="CreateNewSession">+ New Chat</button>
        </div>
        <div class="session-list">
            @foreach (var session in sessions)
            {
                <div class="session-item @(session.Id == currentSessionId ? "active" : "")" @onclick="() => LoadSession(session.Id)">
                    <span class="session-title">@session.Title</span>
                    <button class="delete-btn" @onclick:stopPropagation="true" @onclick="() => DeleteSession(session.Id)">x</button>
                </div>
            }
        </div>
    </div>

    <div class="chat-container">
        <div class="messages-container">
            @foreach (var message in messages)
            {
                <div class="message @(message.IsUser ? "user-message" : "assistant-message")">
                    <div class="message-header">
                        <strong>@(message.IsUser ? "You" : "Assistant")</strong>
                    </div>
                    @if (message.Images.Count > 0)
                    {
                        <div class="message-images">
                            @foreach (var image in message.Images)
                            {
                                <img src="data:@image.ContentType;base64,@image.Base64Data" alt="@image.FileName" class="message-image" />
                            }
                        </div>
                    }
                    <div class="message-content">@message.Content</div>
                </div>
            }
            @if (isLoading)
            {
                <div class="message assistant-message">
                    <div class="message-header">
                        <strong>Assistant</strong>
                    </div>
                    <div class="message-content">
                        <em>Thinking...</em>
                    </div>
                </div>
            }
        </div>

        @if (pendingImages.Count > 0)
        {
            <div class="image-preview-container">
                @foreach (var image in pendingImages)
                {
                    <div class="image-preview">
                        <img src="data:@image.ContentType;base64,@image.Base64Data" alt="@image.FileName" />
                        <button class="remove-image-btn" @onclick="() => RemoveImage(image)">x</button>
                    </div>
                }
            </div>
        }

        <div class="input-container">
            <label class="upload-btn" title="Attach images (max 5, 10MB each) - JPEG, PNG, GIF, WebP only">
                <InputFile OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.gif,.webp" multiple disabled="@isLoading" />
                <span>+</span>
            </label>
            <input type="text"
                   @bind="currentMessage"
                   @bind:event="oninput"
                   @onkeypress="HandleKeyPress"
                   placeholder="Type your message..."
                   disabled="@isLoading"
                   class="message-input" />
            <button @onclick="SendMessage" disabled="@(isLoading || (string.IsNullOrWhiteSpace(currentMessage) && pendingImages.Count == 0))" class="send-button">
                Send
            </button>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">
                @errorMessage
            </div>
        }
    </div>
</div>

<style>
    .chat-layout {
        display: flex;
        height: calc(100vh - 100px);
    }

    .sidebar {
        width: 280px;
        background-color: #f0f0f0;
        border-right: 1px solid #ddd;
        display: flex;
        flex-direction: column;
    }

    .sidebar-header {
        padding: 1rem;
        border-bottom: 1px solid #ddd;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sidebar-header h3 {
        margin: 0;
        font-size: 1rem;
    }

    .new-chat-btn {
        padding: 0.5rem 1rem;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.875rem;
    }

    .new-chat-btn:hover {
        background-color: #0056b3;
    }

    .session-list {
        flex: 1;
        overflow-y: auto;
        padding: 0.5rem;
    }

    .session-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem;
        margin-bottom: 0.25rem;
        border-radius: 4px;
        cursor: pointer;
        background-color: white;
    }

    .session-item:hover {
        background-color: #e9ecef;
    }

    .session-item.active {
        background-color: #007bff;
        color: white;
    }

    .session-title {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .delete-btn {
        background: none;
        border: none;
        color: #999;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    .session-item.active .delete-btn {
        color: rgba(255, 255, 255, 0.7);
    }

    .delete-btn:hover {
        color: #dc3545;
    }

    .chat-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        max-width: 800px;
        margin: 0 auto;
        padding: 1rem;
    }

    .messages-container {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        margin-bottom: 1rem;
        background-color: #f9f9f9;
    }

    .message {
        margin-bottom: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        max-width: 80%;
    }

    .user-message {
        background-color: #007bff;
        color: white;
        margin-left: auto;
    }

    .assistant-message {
        background-color: #e9ecef;
        color: #333;
        margin-right: auto;
    }

    .message-header {
        font-size: 0.8rem;
        margin-bottom: 0.25rem;
        opacity: 0.8;
    }

    .message-images {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .message-image {
        max-width: 200px;
        max-height: 150px;
        border-radius: 4px;
        object-fit: cover;
    }

    .message-content {
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .image-preview-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem;
        background-color: #f0f0f0;
        border-radius: 4px;
        margin-bottom: 0.5rem;
    }

    .image-preview {
        position: relative;
        display: inline-block;
    }

    .image-preview img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 4px;
    }

    .remove-image-btn {
        position: absolute;
        top: -8px;
        right: -8px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background-color: #dc3545;
        color: white;
        border: none;
