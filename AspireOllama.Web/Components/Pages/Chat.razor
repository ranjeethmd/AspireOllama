@code {
    // ============================================================
    // Route Parameters and Component State
    // ============================================================

    /// <summary>
    /// Optional session ID from URL route (/chat/{SessionId}).
    /// If provided, loads that specific session on initialization.
    /// </summary>
    [Parameter]
    public string? SessionId { get; set; }

    // DOM references
    private ElementReference messagesArea;

    // Session and message state
    private List<ChatSession> sessions = new();           // All chat sessions for sidebar
    private List<ChatMessageDisplay> messages = new();     // Messages in current session
    private List<ImageAttachment> pendingImages = new();   // Images queued for next send
    private List<FileAttachment> pendingFiles = new();     // Documents queued for next send
    private string currentMessage = string.Empty;          // Current text input
    private string? currentSessionId;                      // Active session ID
    private bool isLoading = false;                        // AI is processing
    private string? errorMessage;                          // Error display

    // ============================================================
    // File Upload Configuration
    // ============================================================

    private const int MaxFiles = 10;                       // Maximum attachments per message
    private const long MaxFileSize = 20 * 1024 * 1024;     // 20MB per file

    // Accepted file extensions for the file picker
    private const string AcceptedFileTypes = ".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.md,.json,.xml,.log";

    // MIME content type to FileType mapping (preferred detection method)
    private static readonly Dictionary<string, FileType> ContentTypeMap = new(StringComparer.OrdinalIgnoreCase)
    {
        // Images (sent to vision model as binary)
        ["image/jpeg"] = FileType.Image,
        ["image/jpg"] = FileType.Image,
        ["image/png"] = FileType.Image,
        ["image/gif"] = FileType.Image,
        ["image/webp"] = FileType.Image,
        // PDF (text extracted server-side)
        ["application/pdf"] = FileType.Pdf,
        // Word documents
        ["application/vnd.openxmlformats-officedocument.wordprocessingml.document"] = FileType.Word,
        ["application/msword"] = FileType.Word,
        // Excel spreadsheets
        ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"] = FileType.Excel,
        ["application/vnd.ms-excel"] = FileType.Excel,
        // PowerPoint presentations
        ["application/vnd.openxmlformats-officedocument.presentationml.presentation"] = FileType.PowerPoint,
        ["application/vnd.ms-powerpoint"] = FileType.PowerPoint,
        // Text-based files (sent as-is)
        ["text/plain"] = FileType.Text,
        ["text/csv"] = FileType.Text,
        ["text/markdown"] = FileType.Text,
        ["application/json"] = FileType.Text,
        ["application/xml"] = FileType.Text,
        ["text/xml"] = FileType.Text
    };

    // File extension to FileType mapping (fallback detection method)
    private static readonly Dictionary<string, FileType> ExtensionMap = new(StringComparer.OrdinalIgnoreCase)
    {
        [".jpg"] = FileType.Image,
        [".jpeg"] = FileType.Image,
        [".png"] = FileType.Image,
        [".gif"] = FileType.Image,
        [".webp"] = FileType.Image,
        [".pdf"] = FileType.Pdf,
        [".doc"] = FileType.Word,
        [".docx"] = FileType.Word,
        [".xls"] = FileType.Excel,
        [".xlsx"] = FileType.Excel,
        [".ppt"] = FileType.PowerPoint,
        [".pptx"] = FileType.PowerPoint,
        [".txt"] = FileType.Text,
        [".csv"] = FileType.Text,
        [".md"] = FileType.Text,
        [".json"] = FileType.Text,
        [".xml"] = FileType.Text,
        [".log"] = FileType.Text
    };

    // ============================================================
    // Lifecycle Methods
    // ============================================================

    /// <summary>
    /// Initializes component: loads sessions and activates appropriate session.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await RoleService.EnsureLoadedAsync();
        await LoadSessions();

        // Determine which session to activate
        if (!string.IsNullOrEmpty(SessionId))
        {
            // URL contains specific session ID - load it
            await LoadSession(SessionId);
        }
        else if (sessions.Count == 0)
        {
            // No existing sessions - create a new one
            await CreateNewSession();
        }
        else
        {
            // Load most recent session
            await LoadSession(sessions[0].Id);
        }

    }

    // ============================================================
    // Navigation Methods
    // ============================================================

    private void NavigateToAgents()
    {
        Navigation.NavigateTo("/agents", forceLoad: true);
    }

    private void NavigateToDocuments()
    {
        Navigation.NavigateTo("/documents", forceLoad: true);
    }

    // ============================================================
    // Session Management Methods
    // ============================================================

    /// <summary>
    /// Fetches all chat sessions from the API for sidebar display.
    /// </summary>
    private async Task LoadSessions()
    {
        try
        {
            sessions = await ChatClient.GetSessionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load sessions: {ex.Message}";
        }
    }

    /// <summary>
    /// Creates a new chat session and switches to it.
    /// </summary>
    private async Task CreateNewSession()
    {
        try
        {
            var session = await ChatClient.CreateSessionAsync();
            sessions.Insert(0, session); // Add to top of list
            currentSessionId = session.Id;
            messages.Clear();
            pendingImages.Clear();
            pendingFiles.Clear();
            Navigation.NavigateTo($"/chat/{session.Id}", replace: true);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create session: {ex.Message}";
        }
    }

    /// <summary>
    /// Loads a session's messages and switches to it.
    /// </summary>
    private async Task LoadSession(string sessionId)
    {
        try
        {
            var sessionDetails = await ChatClient.GetSessionHistoryAsync(sessionId);
            if (sessionDetails != null)
            {
                currentSessionId = sessionId;
                // Convert API messages to display format (historical messages don't have tool calls stored)
                messages = sessionDetails.Messages.Select(m => new ChatMessageDisplay(
                    m.Content,
                    m.Role == "user",
                    m.Images,
                    m.Files,
                    new List<ToolCall>()
                )).ToList();
                pendingImages.Clear();
                pendingFiles.Clear();
                Navigation.NavigateTo($"/chat/{sessionId}", replace: true);
                StateHasChanged();
                await ScrollToBottom();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load session: {ex.Message}";
        }
    }

    /// <summary>
    /// Deletes a session and switches to another if needed.
    /// </summary>
    private async Task DeleteSession(string sessionId)
    {
        try
        {
            await ChatClient.DeleteSessionAsync(sessionId);
            sessions.RemoveAll(s => s.Id == sessionId);

            // If we deleted the active session, switch to another
            if (currentSessionId == sessionId)
            {
                if (sessions.Count > 0)
                {
                    await LoadSession(sessions[0].Id);
                }
                else
                {
                    await CreateNewSession();
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete session: {ex.Message}";
        }
    }

    // ============================================================
    // File Type Detection Helpers
    // ============================================================

    /// <summary>
    /// Determines file type from MIME type or extension.
    /// </summary>
    private FileType GetFileType(string contentType, string fileName)
    {
        // Try MIME type first (more reliable)
        if (ContentTypeMap.TryGetValue(contentType, out var typeFromContent))
            return typeFromContent;

        // Fall back to file extension
        var extension = Path.GetExtension(fileName);
        if (ExtensionMap.TryGetValue(extension, out var typeFromExt))
            return typeFromExt;

        return FileType.Unknown;
    }

    /// <summary>
    /// Returns display icon for file type badges.
    /// </summary>
    private string GetFileIcon(FileType type) => type switch
    {
        FileType.Pdf => "[PDF]",
        FileType.Word => "[DOC]",
        FileType.Excel => "[XLS]",
        FileType.PowerPoint => "[PPT]",
        FileType.Text => "[TXT]",
        FileType.Image => "[IMG]",
        _ => "[FILE]"
    };

    // ============================================================
    // File Upload Handling
    // ============================================================

    /// <summary>
    /// Handles file selection from the InputFile component.
    /// Validates files and queues them for the next message.
    /// </summary>
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var totalCount = pendingImages.Count + pendingFiles.Count;

        foreach (var file in e.GetMultipleFiles(MaxFiles - totalCount))
        {
            // Check attachment limit
            if (pendingImages.Count + pendingFiles.Count >= MaxFiles)
            {
                errorMessage = $"Maximum {MaxFiles} files allowed.";
                break;
            }

            // Check file size limit
            if (file.Size > MaxFileSize)
            {
                errorMessage = $"File {file.Name} exceeds 20MB limit.";
                continue;
            }

            // Validate file type
            var fileType = GetFileType(file.ContentType, file.Name);
            if (fileType == FileType.Unknown)
            {
                errorMessage = $"Unsupported file type: {file.Name}";
                continue;
            }

            try
            {
                // Read file and convert to base64 for JSON transport
                using var stream = file.OpenReadStream(MaxFileSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());

                if (fileType == FileType.Image)
                {
                    // Normalize content type (some browsers report image/jpg)
                    var contentType = file.ContentType.ToLowerInvariant() switch
                    {
                        "image/jpg" => "image/jpeg",
                        _ => file.ContentType.ToLowerInvariant()
                    };

                    pendingImages.Add(new ImageAttachment
                    {
                        FileName = file.Name,
                        ContentType = contentType,
                        Base64Data = base64
                    });
                }
                else
                {
                    // Document files (PDF, Word, Excel, etc.)
                    pendingFiles.Add(new FileAttachment
                    {
                        FileName = file.Name,
                        ContentType = file.ContentType,
                        Base64Data = base64,
                        Type = fileType
                    });
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to read file {file.Name}: {ex.Message}";
            }
        }

        StateHasChanged();
    }

    /// <summary>
    /// Removes an image from the pending attachments.
    /// </summary>
    private void RemoveImage(ImageAttachment image)
    {
        pendingImages.Remove(image);
        StateHasChanged();
    }

    /// <summary>
    /// Removes a document from the pending attachments.
    /// </summary>
    private void RemoveFile(FileAttachment file)
    {
        pendingFiles.Remove(file);
        StateHasChanged();
    }

    // ============================================================
    // Message Sending
    // ============================================================

    /// <summary>
    /// Handles Enter key to send message.
    /// </summary>
    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading && (!string.IsNullOrWhiteSpace(currentMessage) || pendingImages.Count > 0 || pendingFiles.Count > 0))
        {
            await SendMessage();
        }
    }

    /// <summary>
    /// Sends the current message and attachments to the AI.
    /// Displays optimistic UI update while waiting for response.
    /// </summary>
    private async Task SendMessage()
    {
        // Validate we have something to send
        if ((string.IsNullOrWhiteSpace(currentMessage) && pendingImages.Count == 0 && pendingFiles.Count == 0) || isLoading || string.IsNullOrEmpty(currentSessionId))
            return;

        // Capture current state and clear inputs
        var userMessage = currentMessage.Trim();
        var imagesToSend = pendingImages.ToList();
        var filesToSend = pendingFiles.ToList();
        currentMessage = string.Empty;
        pendingImages.Clear();
        pendingFiles.Clear();
        errorMessage = null;

        // Optimistic UI: show user message immediately
        messages.Add(new ChatMessageDisplay(userMessage, true, imagesToSend, filesToSend, new List<ToolCall>()));
        isLoading = true;
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            // Build and send request to API
            var request = new ChatMessageRequest
            {
                SessionId = currentSessionId,
                Content = userMessage,
                Images = imagesToSend,
                Files = filesToSend
            };

            var response = await ChatClient.SendMessageAsync(request);
            messages.Add(new ChatMessageDisplay(response.Response, false, new List<ImageAttachment>(), new List<FileAttachment>(), response.ToolCalls, response.Usage));

            // Update session title in sidebar if this was the first message
            var session = sessions.FirstOrDefault(s => s.Id == currentSessionId);
            if (session != null && session.Title == "New Chat")
            {
                var title = !string.IsNullOrEmpty(userMessage) ? userMessage :
                    (filesToSend.FirstOrDefault()?.FileName ?? imagesToSend.FirstOrDefault()?.FileName ?? "New Chat");
                session.Title = title.Length > 50 ? title.Substring(0, 47) + "..." : title;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    // ============================================================
    // UI Helpers
    // ============================================================

    private static readonly Markdig.MarkdownPipeline MarkdownPipeline = new Markdig.MarkdownPipelineBuilder().Build();
    private static readonly Ganss.Xss.HtmlSanitizer Sanitizer = CreateSanitizer();

    private static Ganss.Xss.HtmlSanitizer CreateSanitizer()
    {
        var sanitizer = new Ganss.Xss.HtmlSanitizer();
        sanitizer.AllowedSchemes.Clear();
        sanitizer.AllowedSchemes.Add("https");
        sanitizer.AllowedSchemes.Add("http");
        sanitizer.AllowedSchemes.Add("mailto");
        sanitizer.PostProcessNode += (_, e) =>
        {
            if (e.Node is AngleSharp.Html.Dom.IHtmlAnchorElement anchor)
            {
                anchor.SetAttribute("rel", "noopener noreferrer");
                anchor.SetAttribute("target", "_blank");
            }
        };
        return sanitizer;
    }

    private static string RenderMarkdown(string markdown) =>
        Sanitizer.Sanitize(Markdig.Markdown.ToHtml(markdown, MarkdownPipeline));

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollChatToBottom");
        }
        catch { /* component may be disposed */ }
    }

    // ============================================================
    // Display Model
    // ============================================================

    /// <summary>
    /// Record for displaying chat messages with attachments and tool calls.
    /// </summary>
    private record ChatMessageDisplay(
        string Content,
        bool IsUser,
        List<ImageAttachment> Images,
        List<FileAttachment> Files,
        List<ToolCall> ToolCalls,
        UsageInfo? Usage = null);

    // ============================================================
    // Helper Methods
    // ============================================================

    /// <summary>
    /// Formats milliseconds into a human-readable time string.
    /// </summary>
    private static string FormatTime(long milliseconds)
    {
        if (milliseconds < 1000)
            return $"{milliseconds} ms";
        else if (milliseconds < 60000)
            return $"{milliseconds / 1000.0:F1} s";
        else
            return $"{milliseconds / 60000.0:F1} min";
    }
}
