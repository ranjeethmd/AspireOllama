@code {
    [Parameter]
    public string? SessionId { get; set; }

    private List<ChatSession> sessions = new();
    private List<ChatMessageDisplay> messages = new();
    private List<ImageAttachment> pendingImages = new();
    private List<FileAttachment> pendingFiles = new();
    private string currentMessage = string.Empty;
    private string? currentSessionId;
    private bool isLoading = false;
    private string? errorMessage;

    private const int MaxFiles = 10;
    private const long MaxFileSize = 20 * 1024 * 1024; // 20MB

    private const string AcceptedFileTypes = ".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.md,.json,.xml,.log";

    private static readonly Dictionary<string, FileType> ContentTypeMap = new(StringComparer.OrdinalIgnoreCase)
    {
        // Images
        ["image/jpeg"] = FileType.Image,
        ["image/jpg"] = FileType.Image,
        ["image/png"] = FileType.Image,
        ["image/gif"] = FileType.Image,
        ["image/webp"] = FileType.Image,
        // PDF
        ["application/pdf"] = FileType.Pdf,
        // Word
        ["application/vnd.openxmlformats-officedocument.wordprocessingml.document"] = FileType.Word,
        ["application/msword"] = FileType.Word,
        // Excel
        ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"] = FileType.Excel,
        ["application/vnd.ms-excel"] = FileType.Excel,
        // PowerPoint
        ["application/vnd.openxmlformats-officedocument.presentationml.presentation"] = FileType.PowerPoint,
        ["application/vnd.ms-powerpoint"] = FileType.PowerPoint,
        // Text
        ["text/plain"] = FileType.Text,
        ["text/csv"] = FileType.Text,
        ["text/markdown"] = FileType.Text,
        ["application/json"] = FileType.Text,
        ["application/xml"] = FileType.Text,
        ["text/xml"] = FileType.Text
    };

    private static readonly Dictionary<string, FileType> ExtensionMap = new(StringComparer.OrdinalIgnoreCase)
    {
        [".jpg"] = FileType.Image,
        [".jpeg"] = FileType.Image,
        [".png"] = FileType.Image,
        [".gif"] = FileType.Image,
        [".webp"] = FileType.Image,
        [".pdf"] = FileType.Pdf,
        [".doc"] = FileType.Word,
        [".docx"] = FileType.Word,
        [".xls"] = FileType.Excel,
        [".xlsx"] = FileType.Excel,
        [".ppt"] = FileType.PowerPoint,
        [".pptx"] = FileType.PowerPoint,
        [".txt"] = FileType.Text,
        [".csv"] = FileType.Text,
        [".md"] = FileType.Text,
        [".json"] = FileType.Text,
        [".xml"] = FileType.Text,
        [".log"] = FileType.Text
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();

        if (!string.IsNullOrEmpty(SessionId))
        {
            await LoadSession(SessionId);
        }
        else if (sessions.Count == 0)
        {
            await CreateNewSession();
        }
        else
        {
            await LoadSession(sessions[0].Id);
        }
    }

    private async Task LoadSessions()
    {
        try
        {
            sessions = await ChatClient.GetSessionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load sessions: {ex.Message}";
        }
    }

    private async Task CreateNewSession()
    {
        try
        {
            var session = await ChatClient.CreateSessionAsync();
            sessions.Insert(0, session);
            currentSessionId = session.Id;
            messages.Clear();
            pendingImages.Clear();
            pendingFiles.Clear();
            Navigation.NavigateTo($"/chat/{session.Id}", replace: true);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create session: {ex.Message}";
        }
    }

    private async Task LoadSession(string sessionId)
    {
        try
        {
            var sessionDetails = await ChatClient.GetSessionHistoryAsync(sessionId);
            if (sessionDetails != null)
            {
                currentSessionId = sessionId;
                messages = sessionDetails.Messages.Select(m => new ChatMessageDisplay(
                    m.Content,
                    m.Role == "user",
                    m.Images,
                    m.Files
                )).ToList();
                pendingImages.Clear();
                pendingFiles.Clear();
                Navigation.NavigateTo($"/chat/{sessionId}", replace: true);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load session: {ex.Message}";
        }
    }

    private async Task DeleteSession(string sessionId)
    {
        try
        {
            await ChatClient.DeleteSessionAsync(sessionId);
            sessions.RemoveAll(s => s.Id == sessionId);

            if (currentSessionId == sessionId)
            {
                if (sessions.Count > 0)
                {
                    await LoadSession(sessions[0].Id);
                }
                else
                {
                    await CreateNewSession();
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete session: {ex.Message}";
        }
    }

    private FileType GetFileType(string contentType, string fileName)
    {
        if (ContentTypeMap.TryGetValue(contentType, out var typeFromContent))
            return typeFromContent;

        var extension = Path.GetExtension(fileName);
        if (ExtensionMap.TryGetValue(extension, out var typeFromExt))
            return typeFromExt;

        return FileType.Unknown;
    }

    private string GetFileIcon(FileType type) => type switch
    {
        FileType.Pdf => "[PDF]",
        FileType.Word => "[DOC]",
        FileType.Excel => "[XLS]",
        FileType.PowerPoint => "[PPT]",
        FileType.Text => "[TXT]",
        FileType.Image => "[IMG]",
        _ => "[FILE]"
    };

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var totalCount = pendingImages.Count + pendingFiles.Count;

        foreach (var file in e.GetMultipleFiles(MaxFiles - totalCount))
        {
            if (pendingImages.Count + pendingFiles.Count >= MaxFiles)
            {
                errorMessage = $"Maximum {MaxFiles} files allowed.";
                break;
            }

            if (file.Size > MaxFileSize)
            {
                errorMessage = $"File {file.Name} exceeds 20MB limit.";
                continue;
            }

            var fileType = GetFileType(file.ContentType, file.Name);
            if (fileType == FileType.Unknown)
            {
                errorMessage = $"Unsupported file type: {file.Name}";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(MaxFileSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());

                if (fileType == FileType.Image)
                {
                    // Normalize content type for images
                    var contentType = file.ContentType.ToLowerInvariant() switch
                    {
                        "image/jpg" => "image/jpeg",
                        _ => file.ContentType.ToLowerInvariant()
                    };

                    pendingImages.Add(new ImageAttachment
                    {
                        FileName = file.Name,
                        ContentType = contentType,
                        Base64Data = base64
                    });
                }
                else
                {
                    pendingFiles.Add(new FileAttachment
                    {
                        FileName = file.Name,
                        ContentType = file.ContentType,
                        Base64Data = base64,
                        Type = fileType
                    });
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to read file {file.Name}: {ex.Message}";
            }
        }

        StateHasChanged();
    }

    private void RemoveImage(ImageAttachment image)
    {
        pendingImages.Remove(image);
        StateHasChanged();
    }

    private void RemoveFile(FileAttachment file)
    {
        pendingFiles.Remove(file);
        StateHasChanged();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading && (!string.IsNullOrWhiteSpace(currentMessage) || pendingImages.Count > 0 || pendingFiles.Count > 0))
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if ((string.IsNullOrWhiteSpace(currentMessage) && pendingImages.Count == 0 && pendingFiles.Count == 0) || isLoading || string.IsNullOrEmpty(currentSessionId))
            return;

        var userMessage = currentMessage.Trim();
        var imagesToSend = pendingImages.ToList();
        var filesToSend = pendingFiles.ToList();
        currentMessage = string.Empty;
        pendingImages.Clear();
        pendingFiles.Clear();
        errorMessage = null;

        messages.Add(new ChatMessageDisplay(userMessage, true, imagesToSend, filesToSend));
        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new ChatMessageRequest
            {
                SessionId = currentSessionId,
                Content = userMessage,
                Images = imagesToSend,
                Files = filesToSend
            };

            var response = await ChatClient.SendMessageAsync(request);
            messages.Add(new ChatMessageDisplay(response.Response, false, new List<ImageAttachment>(), new List<FileAttachment>()));

            // Update session title in the list if this was the first message
            var session = sessions.FirstOrDefault(s => s.Id == currentSessionId);
            if (session != null && session.Title == "New Chat")
            {
                var title = !string.IsNullOrEmpty(userMessage) ? userMessage :
                    (filesToSend.FirstOrDefault()?.FileName ?? imagesToSend.FirstOrDefault()?.FileName ?? "New Chat");
                session.Title = title.Length > 50 ? title.Substring(0, 47) + "..." : title;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private record ChatMessageDisplay(string Content, bool IsUser, List<ImageAttachment> Images, List<FileAttachment> Files);
}
