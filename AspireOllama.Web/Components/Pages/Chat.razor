        padding: 0;
    }

    .input-container {
        display: flex;
        gap: 0.5rem;
    }

    .upload-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        background-color: #6c757d;
        color: white;
        border-radius: 4px;
        cursor: pointer;
        font-size: 1.5rem;
    }

    .upload-btn:hover {
        background-color: #5a6268;
    }

    .upload-btn input {
        display: none;
    }

    .message-input {
        flex: 1;
        padding: 0.75rem;
        border: 1px solid #ddd;
