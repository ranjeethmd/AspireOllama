@page "/agents"
@using AspireOllama.Web
@using AspireOllama.Shared
@using System.Text.Json
@inject ChatApiClient ChatClient
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>A2A Agents</PageTitle>

<div class="agent-layout">
    <div class="agent-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                </svg>
            </div>
            <span class="brand-text">A2A Agents</span>
        </div>

        <button class="nav-link-btn" @onclick="NavigateToChat">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            Back to Chat
        </button>

        <div class="agents-list">
            <h3 class="sidebar-section-title">Available Agents</h3>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message" style="padding: 12px; background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 8px; margin-bottom: 12px; font-size: 12px; color: #f87171;">
                    @errorMessage
                </div>
            }
            @if (isLoading)
            {
                <div style="padding: 20px; text-align: center; color: #888;">
                    <div class="spinner" style="margin: 0 auto 10px;"></div>
                    Loading agents...
                </div>
            }
            @foreach (var agent in agents)
            {
                <div class="agent-card @(selectedAgent == agent.Name ? "active" : "") @agent.Status" @onclick="() => SelectAgent(agent)">
                    <div class="agent-card-icon">
                        @GetAgentIcon(agent.Name)
                    </div>
                    <div class="agent-card-info">
                        <span class="agent-card-name">@GetAgentDisplayName(agent.Name)</span>
                        <span class="agent-card-skills">@agent.Tools.Count skills</span>
                    </div>
                    <div class="agent-status-indicator @agent.Status"></div>
                </div>
            }
        </div>

        <div class="sidebar-footer">
            <button class="refresh-btn" @onclick="LoadAgents" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(isLoading ? "spinning" : "")">
                    <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                    <polyline points="21 3 21 9 15 9"/>
                </svg>
                Refresh
            </button>
        </div>
    </div>

    <div class="agent-main">
        <div class="agent-header">
            <div class="header-tabs">
                <button class="tab-btn @(activeTab == "skills" ? "active" : "")" @onclick='() => activeTab = "skills"'>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                    </svg>
                    Skill Tester
                </button>
                <button class="tab-btn @(activeTab == "workflow" ? "active" : "")" @onclick='() => activeTab = "workflow"'>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="16 18 22 12 16 6"/>
                        <polyline points="8 6 2 12 8 18"/>
                    </svg>
                    Workflow
                </button>
            </div>
        </div>

        <div class="agents-content">
            @if (activeTab == "skills")
            {
                <div class="skills-panel">
                    @if (selectedAgentInfo != null)
                    {
                        <div class="selected-agent-header">
                            <div class="agent-icon-large">
                                @GetAgentIcon(selectedAgentInfo.Name)
                            </div>
                            <div class="agent-details">
                                <h2>@GetAgentDisplayName(selectedAgentInfo.Name)</h2>
                                <p class="agent-description">@GetAgentDescription(selectedAgentInfo.Name)</p>
                            </div>
                        </div>

                        <div class="skills-grid">
                            @foreach (var skill in selectedAgentInfo.Tools)
                            {
                                <div class="skill-card @(selectedSkill == skill.Name ? "selected" : "")" @onclick="() => SelectSkill(skill)">
                                    <div class="skill-name">@skill.Name</div>
                                    <div class="skill-description">@skill.Description</div>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(selectedSkill))
                        {
                            <div class="skill-execution-panel">
                                <h3>Execute: @selectedSkill</h3>
                                <div class="skill-params">
                                    @foreach (var param in skillParams)
                                    {
                                        <div class="param-input">
                                            <label>@param.Key</label>
                                            <input type="text" @bind="skillParams[param.Key]" placeholder="Enter @param.Key..." />
                                        </div>
                                    }
                                </div>
                                <button class="execute-btn" @onclick="ExecuteSkill" disabled="@isExecuting">
                                    @if (isExecuting)
                                    {
                                        <span class="spinner"></span>
                                        <span>Executing...</span>
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polygon points="5 3 19 12 5 21 5 3"/>
                                        </svg>
                                        <span>Execute</span>
                                    }
                                </button>

                                @if (lastResult != null)
                                {
                                    <div class="result-panel @(lastResult.Success ? "success" : "error")">
                                        <div class="result-header">
                                            <span class="result-status">
                                                @if (lastResult.Success)
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <polyline points="20 6 9 17 4 12"/>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10"/>
                                                        <line x1="15" y1="9" x2="9" y2="15"/>
                                                        <line x1="9" y1="9" x2="15" y2="15"/>
                                                    </svg>
                                                }
                                                @(lastResult.Success ? "Success" : "Failed")
                                            </span>
                                            <span class="result-time">@lastResult.ExecutionTimeMs ms</span>
                                        </div>
                                        <pre class="result-content">@FormatResult(lastResult.Result ?? lastResult.Error)</pre>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="no-selection">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                            </svg>
                            <h3>Select an Agent</h3>
                            <p>Choose an agent from the sidebar to view and test its skills</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="workflow-panel">
                    <div class="workflow-input">
                        <h3>Multi-Agent Workflow</h3>
                        <p>Enter a task and watch the agents collaborate to solve it</p>
                        <div class="workflow-form">
                            <textarea @bind="workflowTask" placeholder="Describe your task... e.g., 'Plan and review a feature implementation for user authentication'" rows="3"></textarea>
                            <button class="execute-btn" @onclick="RunWorkflow" disabled="@isExecuting">
                                @if (isExecuting)
                                {
                                    <span class="spinner"></span>
                                    <span>Running Workflow...</span>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polygon points="5 3 19 12 5 21 5 3"/>
                                    </svg>
                                    <span>Run Workflow</span>
                                }
                            </button>
                        </div>
                    </div>

                    @if (workflowResult != null || isExecuting)
                    {
                        <div class="workflow-results">
                            <div class="workflow-summary">
                                <span class="workflow-task">@(workflowResult?.Task ?? workflowTask)</span>
                                @if (workflowResult != null)
                                {
                                    <span class="workflow-time">Total: @workflowResult.TotalExecutionTimeMs ms</span>
                                }
                                else
                                {
                                    <span class="workflow-time executing">Executing...</span>
                                }
                            </div>

                            <!-- Sequence Diagram View -->
                            <div class="sequence-diagram">
                                <h4 class="diagram-title">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 3v18h18"/>
                                        <path d="M18 9l-5 5-4-4-3 3"/>
                                    </svg>
                                    Agent Call Sequence
                                </h4>

                                <!-- Sequence Flow -->
                                <div class="sequence-flow">
                                    @{
                                        var interactions = workflowResult?.Interactions ?? new List<AgentInteraction>();
                                    }
                                    @foreach (var interaction in interactions)
                                    {
                                        <div class="sequence-call-card @interaction.AgentName @interaction.Status">
                                            <!-- Step Number and Connector -->
                                            <div class="call-step-col">
                                                <div class="call-step-number">@interaction.Step</div>
                                                <div class="call-connector"></div>
                                            </div>

                                            <!-- Call Details -->
                                            <div class="call-details-col">
                                                <!-- Source to Target Arrow -->
                                                <div class="call-flow">
                                                    <div class="call-source">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                                                            <path d="M12 8v8M8 12h8"/>
                                                        </svg>
                                                        <span>API</span>
                                                    </div>
                                                    <div class="call-arrow">
                                                        <div class="arrow-body"></div>
                                                        <div class="mcp-badge">
                                                            <span class="mcp-tag">MCP</span>
                                                            <span class="mcp-func">@interaction.ToolName</span>
                                                        </div>
                                                        <div class="arrow-body"></div>
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                            <polyline points="9 18 15 12 9 6"/>
                                                        </svg>
                                                    </div>
                                                    <div class="call-target-agent @interaction.AgentName">
                                                        @GetAgentIcon(interaction.AgentName)
                                                        <span>@GetAgentDisplayName(interaction.AgentName)</span>
                                                    </div>
                                                </div>

                                                <!-- Execution Info -->
                                                <div class="call-exec-info">
                                                    <span class="exec-status @interaction.Status">
                                                        @if (interaction.Status == "success")
                                                        {
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                                <polyline points="20 6 9 17 4 12"/>
                                                            </svg>
                                                        }
                                                        else
                                                        {
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                                <line x1="18" y1="6" x2="6" y2="18"/>
                                                                <line x1="6" y1="6" x2="18" y2="18"/>
                                                            </svg>
                                                        }
                                                        @interaction.Status
                                                    </span>
                                                    <span class="exec-time">@interaction.ExecutionTimeMs ms</span>
                                                </div>

                                                <!-- Expandable Result -->
                                                <div class="call-result-section">
                                                    <button class="expand-result-btn" @onclick="() => ToggleStepExpansion(interaction.Step)">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(expandedSteps.Contains(interaction.Step) ? "rotated" : "")">
                                                            <polyline points="9 18 15 12 9 6"/>
                                                        </svg>
                                                        @(expandedSteps.Contains(interaction.Step) ? "Hide Result" : "View Result")
                                                    </button>
                                                    @if (expandedSteps.Contains(interaction.Step))
                                                    {
                                                        <div class="result-content">
                                                            <pre class="result-json">@FormatResult(interaction.Result)</pre>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (isExecuting && (workflowResult?.Interactions?.Count ?? 0) == 0)
                                    {
                                        <div class="sequence-call-card executing">
                                            <div class="call-step-col">
                                                <div class="call-step-number">
                                                    <span class="step-spinner"></span>
                                                </div>
                                            </div>
                                            <div class="call-details-col">
                                                <div class="executing-indicator">
                                                    <span class="exec-spinner"></span>
                                                    <span>Executing workflow...</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Call Summary Cards -->
                            @if (workflowResult != null)
                            {
                                <div class="call-summary">
                                    <h4>Call Summary</h4>
                                    <div class="summary-grid">
                                        @foreach (var agentGroup in workflowResult.Interactions.GroupBy(i => i.AgentName))
                                        {
                                            <div class="summary-card @agentGroup.Key">
                                                <div class="summary-card-header">
                                                    @GetAgentIcon(agentGroup.Key)
                                                    <span>@GetAgentDisplayName(agentGroup.Key)</span>
                                                </div>
                                                <div class="summary-card-body">
                                                    <div class="summary-stat">
                                                        <span class="stat-value">@agentGroup.Count()</span>
                                                        <span class="stat-label">calls</span>
                                                    </div>
                                                    <div class="summary-stat">
                                                        <span class="stat-value">@agentGroup.Sum(i => i.ExecutionTimeMs)</span>
                                                        <span class="stat-label">ms total</span>
                                                    </div>
                                                </div>
                                                <div class="summary-functions">
                                                    @foreach (var call in agentGroup)
                                                    {
                                                        <div class="function-chip @call.Status">
                                                            <span class="chip-order">#@call.Step</span>
                                                            <span class="chip-name">@call.ToolName</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="workflow-final">
                                    <strong>Result:</strong> @workflowResult.FinalResult
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .agent-layout {
        display: flex;
        height: 100vh;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        color: #e4e4e4;
    }

    .agent-sidebar {
        width: 280px;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        flex-direction: column;
        padding: 16px;
    }

    .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        margin-bottom: 16px;
    }

    .brand-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .brand-text {
        font-size: 18px;
        font-weight: 600;
    }

    .nav-link-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 10px 16px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #e4e4e4;
        font-size: inherit;
        cursor: pointer;
        margin-bottom: 16px;
        transition: all 0.2s;
    }

    .nav-link-btn:hover {
        background: rgba(255, 255, 255, 0.1);
    }

    .sidebar-section-title {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        margin: 16px 0 8px;
    }

    .agents-list {
        flex: 1;
        overflow-y: auto;
    }

    .agent-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        margin-bottom: 4px;
    }

    .agent-card:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .agent-card.active {
        background: rgba(102, 126, 234, 0.2);
        border: 1px solid rgba(102, 126, 234, 0.3);
    }

    .agent-card-icon {
        width: 36px;
        height: 36px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .agent-card-info {
        flex: 1;
    }

    .agent-card-name {
        display: block;
        font-weight: 500;
    }

    .agent-card-skills {
        font-size: 12px;
        color: #888;
    }

    .agent-status-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #888;
    }

    .agent-status-indicator.connected {
        background: #4ade80;
    }

    .agent-status-indicator.error {
        background: #f87171;
    }

    .sidebar-footer {
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .refresh-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #e4e4e4;
        cursor: pointer;
        transition: all 0.2s;
    }

    .refresh-btn:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.1);
    }

    .spinning {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .agent-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .agent-header {
        padding: 16px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .header-tabs {
        display: flex;
        gap: 8px;
    }

    .tab-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        color: #888;
        cursor: pointer;
        transition: all 0.2s;
    }

    .tab-btn:hover {
        color: #e4e4e4;
        border-color: rgba(255, 255, 255, 0.2);
    }

    .tab-btn.active {
        background: rgba(102, 126, 234, 0.2);
        border-color: rgba(102, 126, 234, 0.3);
        color: #e4e4e4;
    }

    .agents-content {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
    }

    .no-selection {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #888;
        text-align: center;
    }

    .no-selection svg {
        margin-bottom: 16px;
        opacity: 0.5;
    }

    .selected-agent-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding: 20px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 12px;
    }

    .agent-icon-large {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .agent-details h2 {
        margin: 0 0 4px;
    }

    .agent-description {
        color: #888;
        margin: 0;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 12px;
        margin-bottom: 24px;
    }

    .skill-card {
        padding: 16px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .skill-card:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .skill-card.selected {
        background: rgba(102, 126, 234, 0.2);
        border-color: rgba(102, 126, 234, 0.4);
    }

    .skill-name {
        font-weight: 600;
        font-family: monospace;
        margin-bottom: 8px;
        color: #a78bfa;
    }

    .skill-description {
        font-size: 13px;
        color: #888;
    }

    .skill-execution-panel {
        padding: 20px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 12px;
    }

    .skill-execution-panel h3 {
        margin: 0 0 16px;
    }

    .skill-params {
        margin-bottom: 16px;
    }

    .param-input {
        margin-bottom: 12px;
    }

    .param-input label {
        display: block;
        font-size: 13px;
        color: #888;
        margin-bottom: 4px;
    }

    .param-input input {
        width: 100%;
        padding: 10px 14px;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        color: #e4e4e4;
        font-size: 14px;
    }

    .param-input input:focus {
        outline: none;
        border-color: rgba(102, 126, 234, 0.5);
    }

    .execute-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 24px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

    .execute-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .execute-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .result-panel {
        margin-top: 16px;
        padding: 16px;
        border-radius: 8px;
        border: 1px solid;
    }

    .result-panel.success {
        background: rgba(74, 222, 128, 0.1);
