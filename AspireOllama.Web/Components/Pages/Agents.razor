@code {
    private List<AgentInfo> agents = [];
    private string selectedAgent = "";
    private AgentInfo? selectedAgentInfo;
    private string selectedSkill = "";
    private Dictionary<string, string> skillParams = [];
    private bool isLoading = false;
    private bool isExecuting = false;
    private string activeTab = "skills";
    private string workflowTask = "";
    private AgentCallResponse? lastResult;
    private AgentWorkflowResponse? workflowResult;
    private HashSet<int> expandedSteps = new();

    // Available agents for sequence diagram lanes
    private static readonly string[] AllAgents = ["planner", "reviewer", "research", "code"];

    private IEnumerable<string> GetUniqueAgents()
    {
        if (workflowResult?.Interactions?.Any() == true)
        {
            return workflowResult.Interactions.Select(i => i.AgentName).Distinct();
        }
        return AllAgents;
    }

    private void ToggleStepExpansion(int step)
    {
        if (!expandedSteps.Remove(step))
        {
            expandedSteps.Add(step);
        }
    }

    private string GetArrowStyle(string agentName)
    {
        var agents = GetUniqueAgents().ToList();
        var index = agents.IndexOf(agentName);
        // Calculate arrow width based on agent position
        var widthPercent = ((index + 1) * 100) / (agents.Count + 1);
        return $"--arrow-width: {widthPercent}%;";
    }

    private string GetAgentColor(string name) => name switch
    {
        "planner" => "#667eea",
        "reviewer" => "#22c55e",
        "research" => "#f59e0b",
        "code" => "#ec4899",
        _ => "#888"
    };

    private string? errorMessage;

    protected override void OnInitialized()
    {
        // Start loading agents without blocking render
        _ = LoadAgentsAsync();
    }

    private async Task LoadAgentsAsync()
    {
        await LoadAgents();
        await InvokeAsync(StateHasChanged);
    }

    private void NavigateToChat()
    {
        Navigation.NavigateTo("/");
    }

    private async Task LoadAgents()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            agents = await ChatClient.GetAgentsAsync(cts.Token);
        }
        catch (OperationCanceledException)
        {
            errorMessage = "Loading agents timed out. The API service may be unavailable.";
            agents = [];
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading agents: {ex.Message}";
            agents = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectAgent(AgentInfo agent)
    {
        selectedAgent = agent.Name;
        selectedAgentInfo = agent;
        selectedSkill = "";
        skillParams.Clear();
        lastResult = null;
    }

    private void SelectSkill(AgentTool skill)
    {
        selectedSkill = skill.Name;
        lastResult = null;

        // Set up default parameters based on skill name
        skillParams.Clear();
        switch (skill.Name)
        {
            case "create_plan":
            case "assess_complexity":
            case "suggest_agents":
                skillParams["task"] = "";
                break;
            case "search_knowledge":
            case "suggest_topics":
                skillParams["query"] = "";
                break;
            case "get_topic_details":
                skillParams["topic"] = "";
                break;
            case "gather_context":
                skillParams["topics"] = "";
                break;
            case "compare_topics":
                skillParams["topic1"] = "";
                skillParams["topic2"] = "";
                break;
            case "review_response":
                skillParams["originalPrompt"] = "";
                skillParams["response"] = "";
                break;
            case "review_code":
                skillParams["code"] = "";
                skillParams["language"] = "csharp";
                break;
            case "review_plan":
                skillParams["planJson"] = "";
                break;
            case "execute_csharp":
                skillParams["code"] = "";
                break;
            case "generate_code":
                skillParams["description"] = "";
                skillParams["language"] = "csharp";
                break;
            case "analyze_code":
            case "format_code":
                skillParams["code"] = "";
                break;
            case "generate_tests":
                skillParams["code"] = "";
                skillParams["framework"] = "xunit";
                break;
            default:
                // Generic parameter
                skillParams["input"] = "";
                break;
        }
    }

    private async Task ExecuteSkill()
    {
        if (string.IsNullOrEmpty(selectedAgent) || string.IsNullOrEmpty(selectedSkill))
            return;

        isExecuting = true;
        try
        {
            var request = new AgentCallRequest
            {
                AgentName = selectedAgent,
                ToolName = selectedSkill,
                Arguments = skillParams.ToDictionary(p => p.Key, p => (object?)p.Value)
            };

            lastResult = await ChatClient.CallAgentToolAsync(request);
        }
        catch (Exception ex)
        {
            lastResult = new AgentCallResponse
            {
                AgentName = selectedAgent,
                ToolName = selectedSkill,
                Success = false,
                Error = ex.Message
            };
        }
        finally
        {
            isExecuting = false;
        }
    }

    private async Task RunWorkflow()
    {
        if (string.IsNullOrWhiteSpace(workflowTask))
            return;

        isExecuting = true;
        workflowResult = null;
        expandedSteps.Clear();

        try
        {
            var request = new AgentWorkflowRequest { Task = workflowTask };
            workflowResult = await ChatClient.RunWorkflowAsync(request);
        }
        catch (Exception ex)
        {
            workflowResult = new AgentWorkflowResponse
            {
                Task = workflowTask,
                FinalResult = $"Error: {ex.Message}",
                Interactions = []
            };
        }
        finally
        {
            isExecuting = false;
        }
    }

    private string GetAgentDisplayName(string name) => name switch
    {
        "planner" => "Planner Agent",
        "reviewer" => "Reviewer Agent",
        "research" => "Research Agent",
        "code" => "Code Agent",
        _ => name
    };

    private string GetAgentDescription(string name) => name switch
    {
        "planner" => "Breaks down complex tasks into actionable steps and coordinates multi-agent workflows",
        "reviewer" => "Reviews and validates content, code, and responses for quality assurance",
        "research" => "Gathers information, searches knowledge bases, and provides context",
        "code" => "Code generation, execution, analysis, and testing",
        _ => ""
    };

    private MarkupString GetAgentIcon(string name)
    {
        var svg = name switch
        {
            "planner" => """<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6"/><path d="M9 16h6"/></svg>""",
            "reviewer" => """<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>""",
            "research" => """<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>""",
            "code" => """<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>""",
            _ => """<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>"""
        };
        return new MarkupString(svg);
    }

    private string FormatResult(object? result)
    {
        if (result == null) return "null";

        try
        {
            if (result is JsonElement element)
            {
                return JsonSerializer.Serialize(element, new JsonSerializerOptions { WriteIndented = true });
            }
            return result.ToString() ?? "null";
        }
        catch
        {
            return result.ToString() ?? "null";
        }
    }
}
